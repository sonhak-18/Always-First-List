# Nomor WhatsApp Dosen (hanya angka dengan kode negara, contoh: 6281234567890)
DOSEN_PHONE=628xxxxxxxxxx

# JID Group Bimbingan (didapat otomatis saat bot pertama kali jalan di console)
SOURCE_GROUP_JID=120363xxxxxxxxxxxx@g.us

# JID Group Listing (tempat bot akan otomatis kirim chat listing)
TARGET_GROUP_JID=120363xxxxxxxxxxxx@g.us

# Anggota tim untuk listing (pisahkan dengan koma)
LISTING_MEMBERS=Nama Anggota 1, Nama Anggota 2, Nama Anggota 3

# Cooldown anti-spam (dalam menit) agar tidak kirim dobel jika dosen chat berkali-kali
COOLDOWN_MINUTES=15

# Host dan Port Konsol Web Lokal (default terikat ke 127.0.0.1 untuk isolasi keamanan)
PORT=3000
HOST=127.0.0.1

